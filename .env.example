# ─── Database ─────────────────────────────────────────────────────────────────
# Supabase (recommended) or Railway PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/gold_dutchy?schema=public"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-min-32-chars-change-in-production"

# ─── OAuth Providers ──────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# ─── AI Categorization (OpenAI or Anthropic) ──────────────────────────────────
# Used for expense auto-categorization in production
OPENAI_API_KEY="sk-..."
# OR
ANTHROPIC_API_KEY="sk-ant-..."

# ─── Email (Nodemailer) ───────────────────────────────────────────────────────
SMTP_HOST="smtp.resend.com"
SMTP_PORT="465"
SMTP_USER="resend"
SMTP_PASSWORD="your-resend-api-key"
FROM_EMAIL="noreply@golddutchy.com"

# ─── Storage (for receipt uploads) ───────────────────────────────────────────
# Supabase Storage or Cloudflare R2
NEXT_PUBLIC_SUPABASE_URL="https://xxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Gold Dutchy"
